{
  "name": "sanity-starter",
  "private": true,
  "version": "1.0.0",
  "main": "package.json",
  "license": "MIT",
  "scripts": {
    "dev": "sanity dev",
    "start": "sanity start",
    "build": "sanity build && bun run typegen",
    "deploy": "sanity deploy",
    "deploy-graphql": "sanity graphql deploy",
    "typegen": "sanity schema extract --path types/schema.json && sanity typegen generate",
    "typegen:watch": "sanity typegen generate --watch"
  },
  "keywords": [
    "sanity"
  ],
  "dependencies": {
    "@sanity/language-filter": "^4.1.0",
    "@sanity/vision": "^5.17.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "sanity": "^5.17.1",
    "sanity-plugin-media-i18n": "^2.3.6",
    "styled-components": "^6.3.11"
  },
  "devDependencies": {
    "@sanity/eslint-config-studio": "^6.0.0",
    "@types/react": "^19.2.14",
    "eslint": "^10.0.3",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3"
  },
  "prettier": {
    "semi": false,
    "printWidth": 100,
    "bracketSpacing": false,
    "singleQuote": true
  }
}
