{
  "name": "sanity-starter",
  "private": true,
  "version": "1.0.0",
  "main": "package.json",
  "license": "MIT",
  "scripts": {
    "dev": "sanity dev",
    "start": "sanity start",
    "build": "sanity build && bun run typegen",
    "deploy": "sanity deploy",
    "deploy-graphql": "sanity graphql deploy",
    "typegen": "sanity schema extract --enforce-required-fields --force && sanity typegen generate",
    "typegen:watch": "sanity typegen generate --watch",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write ."
  },
  "keywords": [
    "sanity"
  ],
  "dependencies": {
    "@sanity/icons": "^5.2.3",
    "@sanity/language-filter": "^5.0.21",
    "@sanity/vision": "^6.18.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sanity": "^6.18.0",
    "sanity-plugin-media": "^6.3.4",
    "styled-components": "^6.6.0"
  },
  "devDependencies": {
    "@sanity/eslint-config-studio": "^7.0.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "eslint": "^10.12.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3"
  },
  "prettier": {
    "semi": false,
    "printWidth": 100,
    "bracketSpacing": false,
    "singleQuote": true
  }
}
